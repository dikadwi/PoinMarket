{
    "openapi": "3.0.2",
    "info": {
      "title": "API Dokumentasi PoinMarket",
      "description": "Dokumentasi API untuk aplikasi PoinMarket, yang menyediakan layanan untuk mengelola data dan transaksi. Dengan API ini, pengguna dapat melakukan operasi CRUD pada data yang tersedia dan mengakses berbagai fitur aplikasi.",
      "version": "1.0.0"
    },
    "externalDocs": {
      "description": "Temukan lebih lanjut tentang PoinMarket",
      "url": "https://pointmarket.tigaselaras.com/"
    },
    "servers": [
      {
        "url": "http://localhost/PoinMarket/public/api/"
      }
    ],
    "tags": [
      {
        "name": "Badges",
        "description": "Operations about badges"
      }
    ],
    "paths": {
      "/badges": {
        "get": {
          "tags": ["Badges"],
          "summary": "Get all badges",
          "description": "Retrieve a list of all badges.",
          "operationId": "getBadges",
          "responses": {
            "200": {
              "description": "A list of badges",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/Badge"
                    }
                  }
                }
              }
            }
          }
        },
        "post": {
          "tags": ["Badges"],
          "summary": "Add a new badge",
          "description": "Create a new badge.",
          "operationId": "addBadge",
          "requestBody": {
            "description": "Badge object to be added",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Badge"
                }
              }
            },
            "required": true
          },
          "responses": {
            "201": {
              "description": "Badge created"
            },
            "400": {
              "description": "Invalid input"
            }
          }
        }
      },
      "/badges/{id}": {
        "get": {
          "tags": ["Badges"],
          "summary": "Get badge by ID",
          "description": "Retrieve a badge by its ID.",
          "operationId": "getBadgeById",
          "parameters": [
            {
              "name": "id",
              "in": "path",
              "required": true,
              "description": "ID of badge to return",
              "schema": {
                "type": "integer"
              }
            }
          ],
          "responses": {
            "200": {
              "description": "Badge details",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Badge"
                  }
                }
              }
            },
            "404": {
              "description": "Badge not found"
            }
          }
        },
        "put": {
          "tags": ["Badges"],
          "summary": "Update an existing badge",
          "description": "Update a badge by ID.",
          "operationId": "updateBadge",
          "parameters": [
            {
              "name": "id",
              "in": "path",
              "required": true,
              "description": "ID of badge to update",
              "schema": {
                "type": "integer"
              }
            }
          ],
          "requestBody": {
            "description": "Badge object to be updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Badge"
                }
              }
            },
            "required": true
          },
          "responses": {
            "200": {
              "description": "Badge updated"
            },
            "400": {
              "description": "Invalid ID supplied"
            },
            "404": {
              "description": "Badge not found"
            }
          }
        },
        "delete": {
          "tags": ["Badges"],
          "summary": "Delete a badge",
          "description": "Delete a badge by ID.",
          "operationId": "deleteBadge",
          "parameters": [
            {
              "name": "id",
              "in": "path",
              "required": true,
              "description": "ID of badge to delete",
              "schema": {
                "type": "integer"
              }
            }
          ],
          "responses": {
            "204": {
              "description": "Badge deleted"
            },
            "404": {
              "description": "Badge not found"
            }
          }
        }
      }
    },
    "components": {
      "schemas": {
        "Badge": {
          "type": "object",
          "properties": {
            "id": {
              "type": "integer",
              "format": "int64"
            },
            "name": {
              "type": "string"
            },
            "description": {
              "type": "string"
            }
          }
        }
      }
    }
  }