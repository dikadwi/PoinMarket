    // Relationships
    Superadmin -> manage_users;
    Superadmin -> system_config;
    Superadmin -> monitor_activity;
    
    Admin -> manage_products;
    Admin -> manage_transactions;
    Admin -> manage_notifications;
    
    Dosen -> manage_points;
    Dosen -> evaluate_students;
